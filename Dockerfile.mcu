# MCU Friday — Headless Docker deployment
#
# Build (from project root):
#   docker build -f Dockerfile.mcu -t friday-mcu .
#
# Run:
#   docker run -d --name friday \
#     -e WHATSAPP_ACCESS_TOKEN=xxx \
#     -e WHATSAPP_PHONE_NUMBER_ID=xxx \
#     -e WHATSAPP_DEFAULT_PHONE=xxx \
#     -e TELEGRAM_BOT_TOKEN=xxx \
#     -e TELEGRAM_DEFAULT_CHAT=xxx \
#     -e DISCORD_BOT_TOKEN=xxx \
#     -e DISCORD_CHANNEL_ID=xxx \
#     -e GMAIL_CLIENT_ID=xxx \
#     -e GMAIL_CLIENT_SECRET=xxx \
#     -e GMAIL_REFRESH_TOKEN=xxx \
#     -p 8080:8080 \
#     friday-mcu

FROM python:3.12-slim

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

# App user
RUN groupadd -r friday && useradd -r -g friday -d /app friday

WORKDIR /app

# Install dependencies first (cached layer)
COPY pyproject_mcu.toml pyproject.toml
COPY docs/MCU_FRIDAY_ARCHITECTURE.md docs/MCU_FRIDAY_ARCHITECTURE.md
RUN pip install --no-cache-dir "requests>=2.31.0" "fastapi>=0.100.0" "uvicorn>=0.23.0" "pydantic>=2.0.0"

# Copy app code
COPY friday_mcu/ friday_mcu/

# Runtime dirs
RUN mkdir -p /app/var/state /app/var/logs && chown -R friday:friday /app

USER friday

# Expose API port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=60s --timeout=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8080/health', timeout=5)" || exit 1

# Start API server
CMD ["python", "-m", "friday_mcu.api.server"]
